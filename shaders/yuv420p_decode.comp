#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0,rgba8) uniform writeonly image2D outputImage;
layout(binding=1) uniform sampler2D inputY;
layout(binding=2) uniform sampler2D inputU;
layout(binding=3) uniform sampler2D inputV;
layout(push_constant) uniform Conversion {
    float kr;
    float kb;
    float yOffset;
    float yScale;
    float chromaScale;
    uint nv12;
    uint width;
    uint height;
} c;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(p.x>=int(c.width)||p.y>=int(c.height)) return;
    vec2 uv=texelFetch(inputU,p/2,0).rg*255.0;
    float y=(texelFetch(inputY,p,0).r*255.0-c.yOffset)*c.yScale;
    float u=(uv.r-128.0)*c.chromaScale;
    float v=((c.nv12!=0?uv.g:texelFetch(inputV,p/2,0).r*255.0)-128.0)*c.chromaScale;
    float kg=1.0-c.kr-c.kb;
    vec3 rgb=vec3(y+2.0*(1.0-c.kr)*v,
        y-2.0*c.kb*(1.0-c.kb)/kg*u-2.0*c.kr*(1.0-c.kr)/kg*v,
        y+2.0*(1.0-c.kb)*u);
    // UNORM storage preserves encoded RGB; the retained sRGB sampling view
    // follows the same transfer behavior as the software RGBA upload path.
    imageStore(outputImage,p,vec4(clamp(rgb,0.0,1.0),1.0));
}
