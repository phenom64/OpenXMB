if(NOT DEFINED HOST OR NOT DEFINED CORE OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "HOST, CORE and OUTPUT_DIR are required")
endif()
file(REMOVE_RECURSE "${OUTPUT_DIR}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
execute_process(COMMAND "${HOST}" --core "${CORE}" --headless --frames 6 --screenshot "${OUTPUT_DIR}/frame.bmp" --save-on-exit --state-directory "${OUTPUT_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT status EQUAL 0 OR NOT output MATCHES "frames=6 video_callbacks=6 audio_frames=774")
  message(FATAL_ERROR "Native libretro smoke failed: ${status}\n${output}\n${error}")
endif()
file(READ "${OUTPUT_DIR}/frame.bmp" bitmap_magic LIMIT 2 HEX)
if(NOT bitmap_magic STREQUAL "424d")
  message(FATAL_ERROR "The host did not capture its rendered frame")
endif()
file(GLOB states "${OUTPUT_DIR}/*.state")
file(GLOB ram "${OUTPUT_DIR}/*.srm")
list(LENGTH states state_count)
list(LENGTH ram ram_count)
if(NOT state_count EQUAL 1 OR NOT ram_count EQUAL 1)
  message(FATAL_ERROR "The host did not persist state and save RAM")
endif()
list(GET states 0 state)
file(READ "${state}" state_bytes HEX)
if(NOT state_bytes STREQUAL "06000000")
  message(FATAL_ERROR "Unexpected serialized frame counter: ${state_bytes}")
endif()
execute_process(COMMAND "${HOST}" --core "${CORE}" --headless --frames 2 --save-on-exit --load-state "${state}" --state-directory "${OUTPUT_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
file(READ "${state}" state_bytes HEX)
if(NOT status EQUAL 0 OR NOT state_bytes STREQUAL "08000000" OR NOT output MATCHES "state_loaded=")
  message(FATAL_ERROR "Native libretro state restoration failed: ${status}\n${output}\n${error}\nstate=${state_bytes}")
endif()
message(STATUS "Native libretro video/audio/input callbacks, save states, load states and save RAM passed")
