  set_tests_properties(openxmb_rpcs3_library_tests PROPERTIES TIMEOUT 20)

  add_executable(openxmb_game_preview_audio_tests "${PROJECT_SOURCE_DIR}/tests/desktop/preview_audio_tests.cpp")
