find_package(LibArchive REQUIRED)
add_library(openxmb_documents STATIC src/documents/document.cpp)
add_library(OpenXMB::Documents ALIAS openxmb_documents)
target_compile_features(openxmb_documents PUBLIC cxx_std_23)
target_include_directories(openxmb_documents PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/include")
target_link_libraries(openxmb_documents PUBLIC OpenXMB::Photos LibArchive::LibArchive)
set_target_properties(openxmb_documents PROPERTIES CXX_SCAN_FOR_MODULES OFF)
target_link_libraries(XMS PRIVATE OpenXMB::Documents)
target_sources(XMS PUBLIC FILE_SET CXX_MODULES FILES src/programs/document_viewer.cppm)
if(OPENXMB_BUILD_NATIVE_TESTS)
  add_executable(openxmb_document_tests tests/documents/document_tests.cpp)
  target_link_libraries(openxmb_document_tests PRIVATE OpenXMB::Documents)
  set_target_properties(openxmb_document_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
  add_test(NAME openxmb_document_tests COMMAND openxmb_document_tests)
endif()
