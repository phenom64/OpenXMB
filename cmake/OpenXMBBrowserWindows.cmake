# Include after cmake/Integrations.cmake. No ATL, .NET, NuGet client, or Edge
# installation is required to build. The Evergreen WebView2 Runtime is needed
# on the machine running the installed application.
include_guard(GLOBAL)
if(NOT WIN32)
  return()
endif()
get_filename_component(_openxmb_browser_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(OPENXMB_WEBVIEW2_CACHE_DIR "${CMAKE_BINARY_DIR}/_deps/webview2" CACHE PATH
    "Persistent cache for the pinned Microsoft WebView2 SDK")
set(OPENXMB_WEBVIEW2_SDK_DIR "" CACHE PATH "Use an already extracted WebView2 NuGet SDK (offline builds)")
set(_openxmb_webview2_version "1.0.3650.58")
set(_openxmb_webview2_hash "911a472128c82ac8baa0c486c23342cc9dd6e7dc50d754e676726642ca065c60")
if(NOT OPENXMB_WEBVIEW2_SDK_DIR)
  file(MAKE_DIRECTORY "${OPENXMB_WEBVIEW2_CACHE_DIR}")
  file(LOCK "${OPENXMB_WEBVIEW2_CACHE_DIR}/sdk.lock" GUARD FILE TIMEOUT 120)
  set(_openxmb_webview2_package "${OPENXMB_WEBVIEW2_CACHE_DIR}/microsoft.web.webview2.${_openxmb_webview2_version}.nupkg")
  set(_openxmb_webview2_sdk "${OPENXMB_WEBVIEW2_CACHE_DIR}/${_openxmb_webview2_version}")
  if(NOT EXISTS "${_openxmb_webview2_package}")
    file(DOWNLOAD
      "https://api.nuget.org/v3-flatcontainer/microsoft.web.webview2/${_openxmb_webview2_version}/microsoft.web.webview2.${_openxmb_webview2_version}.nupkg"
      "${_openxmb_webview2_package}.download"
      EXPECTED_HASH "SHA256=${_openxmb_webview2_hash}" TLS_VERIFY ON STATUS _openxmb_download_status)
    list(GET _openxmb_download_status 0 _openxmb_download_code)
    if(NOT _openxmb_download_code EQUAL 0)
      message(FATAL_ERROR "Cannot acquire WebView2 SDK: ${_openxmb_download_status}. Set OPENXMB_WEBVIEW2_SDK_DIR for offline builds.")
    endif()
    file(RENAME "${_openxmb_webview2_package}.download" "${_openxmb_webview2_package}")
  endif()
  file(SHA256 "${_openxmb_webview2_package}" _openxmb_cached_hash)
  if(NOT _openxmb_cached_hash STREQUAL _openxmb_webview2_hash)
    message(FATAL_ERROR "Cached WebView2 SDK checksum mismatch: ${_openxmb_webview2_package}")
  endif()
  if(NOT EXISTS "${_openxmb_webview2_sdk}/build/native/include/WebView2.h")
    file(ARCHIVE_EXTRACT INPUT "${_openxmb_webview2_package}" DESTINATION "${_openxmb_webview2_sdk}")
  endif()
else()
  set(_openxmb_webview2_sdk "${OPENXMB_WEBVIEW2_SDK_DIR}")
endif()
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$" OR CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
  set(_openxmb_webview2_arch arm64)
elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(_openxmb_webview2_arch x64)
else()
  set(_openxmb_webview2_arch x86)
endif()
set(_openxmb_webview2_loader "${_openxmb_webview2_sdk}/build/native/${_openxmb_webview2_arch}/WebView2LoaderStatic.lib")
if(NOT EXISTS "${_openxmb_webview2_sdk}/build/native/include/WebView2.h" OR NOT EXISTS "${_openxmb_webview2_loader}")
  message(FATAL_ERROR "WebView2 SDK at ${_openxmb_webview2_sdk} has no headers/static loader for ${_openxmb_webview2_arch}")
endif()
add_executable(openxmb-web WIN32 "${_openxmb_browser_root}/src/integrations/web_view_win.cpp")
target_include_directories(openxmb-web PRIVATE "${_openxmb_browser_root}/include" "${_openxmb_webview2_sdk}/build/native/include")
target_compile_features(openxmb-web PRIVATE cxx_std_23)
target_compile_definitions(openxmb-web PRIVATE UNICODE _UNICODE)
target_link_libraries(openxmb-web PRIVATE OpenXMB::Integrations nlohmann_json::nlohmann_json
  "${_openxmb_webview2_loader}" ole32 oleaut32 user32 gdi32 shell32 shlwapi version)
set_target_properties(openxmb-web PROPERTIES CXX_SCAN_FOR_MODULES OFF)
install(TARGETS openxmb-web RUNTIME DESTINATION bin)
install(FILES "${_openxmb_webview2_sdk}/LICENSE.txt" "${_openxmb_webview2_sdk}/NOTICE.txt"
  DESTINATION share/licenses/OpenXMB/WebView2 OPTIONAL)
if(TARGET XMS)
  add_dependencies(XMS openxmb-web)
endif()
if(OPENXMB_BUILD_NATIVE_TESTS)
  add_executable(openxmb_browser_protocol_tests "${_openxmb_browser_root}/tests/integrations/browser_protocol_tests.cpp")
  target_link_libraries(openxmb_browser_protocol_tests PRIVATE OpenXMB::Integrations nlohmann_json::nlohmann_json)
  set_target_properties(openxmb_browser_protocol_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
  add_test(NAME openxmb_browser_protocol_tests COMMAND openxmb_browser_protocol_tests)
  add_executable(openxmb_browser_windows_tests "${_openxmb_browser_root}/tests/integrations/browser_windows_tests.cpp")
  target_link_libraries(openxmb_browser_windows_tests PRIVATE OpenXMB::Integrations nlohmann_json::nlohmann_json)
  set_target_properties(openxmb_browser_windows_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
  add_dependencies(openxmb_browser_windows_tests openxmb-web)
  option(OPENXMB_BROWSER_RUNTIME_TESTS "Run interactive Windows WebView2 tests (requires desktop and Evergreen Runtime)" OFF)
  if(OPENXMB_BROWSER_RUNTIME_TESTS)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    add_test(NAME openxmb_browser_windows_runtime
      COMMAND "${Python3_EXECUTABLE}" "${_openxmb_browser_root}/tests/integrations/web_view_windows_smoke.py"
      --test "$<TARGET_FILE:openxmb_browser_windows_tests>")
    set_tests_properties(openxmb_browser_windows_runtime PROPERTIES TIMEOUT 250 RUN_SERIAL TRUE)
  endif()
endif()
