# Native desktop services and a process-isolated software libretro host.
get_filename_component(_openxmb_integrations_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(openxmb_integrations STATIC
  "${_openxmb_integrations_root}/src/integrations/desktop.cpp"
  "${_openxmb_integrations_root}/src/integrations/owned_process.cpp"
  "${_openxmb_integrations_root}/src/integrations/observed_process.cpp"
  "${_openxmb_integrations_root}/src/integrations/session_window.cpp"
  "${_openxmb_integrations_root}/src/integrations/xmb_overlay.cpp"
  "${_openxmb_integrations_root}/src/integrations/guide_input.cpp"
  "${_openxmb_integrations_root}/src/integrations/session_hotkey.cpp"
  "${_openxmb_integrations_root}/src/integrations/browser_input.cpp"
  "${_openxmb_integrations_root}/src/integrations/disc.cpp")
add_library(OpenXMB::Integrations ALIAS openxmb_integrations)
target_include_directories(openxmb_integrations PUBLIC "${_openxmb_integrations_root}/include")
target_compile_features(openxmb_integrations PUBLIC cxx_std_23)
target_link_libraries(openxmb_integrations PRIVATE nlohmann_json::nlohmann_json)
set_target_properties(openxmb_integrations PROPERTIES CXX_SCAN_FOR_MODULES OFF)
if(WIN32)
  target_link_libraries(openxmb_integrations PUBLIC advapi32 gdiplus gdi32 user32 dwmapi)
elseif(APPLE)
  target_link_libraries(openxmb_integrations PUBLIC "-framework ApplicationServices")
else()
  find_package(X11 REQUIRED)
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(OPENXMB_XCB REQUIRED IMPORTED_TARGET xcb xcb-render xcb-res)
  target_include_directories(openxmb_integrations PRIVATE ${X11_INCLUDE_DIR})
  target_link_libraries(openxmb_integrations PUBLIC ${X11_LIBRARIES} PkgConfig::OPENXMB_XCB ${CMAKE_DL_LIBS})
endif()
add_executable(openxmb-integrations "${_openxmb_integrations_root}/src/integrations/cli.cpp")
target_link_libraries(openxmb-integrations PRIVATE OpenXMB::Integrations)
set_target_properties(openxmb-integrations PROPERTIES CXX_SCAN_FOR_MODULES OFF)
add_executable(openxmb-retro "${_openxmb_integrations_root}/src/integrations/retro_host.cpp")
target_link_libraries(openxmb-retro PRIVATE OpenXMB::Integrations SDL2::SDL2 ${CMAKE_DL_LIBS})
target_compile_definitions(openxmb-retro PRIVATE SDL_MAIN_HANDLED)
set_target_properties(openxmb-retro PROPERTIES CXX_SCAN_FOR_MODULES OFF)
if(MSVC)
  target_compile_options(openxmb_integrations PRIVATE /W4)
  target_compile_options(openxmb-retro PRIVATE /W4)
else()
  target_compile_options(openxmb_integrations PRIVATE -Wall -Wextra -Wpedantic)
  target_compile_options(openxmb-retro PRIVATE -Wall -Wextra -Wpedantic)
endif()
install(TARGETS openxmb-integrations openxmb-retro RUNTIME DESTINATION bin)
if(OPENXMB_BUILD_NATIVE_TESTS)
  add_executable(openxmb_process_environment_tests "${_openxmb_integrations_root}/tests/integrations/process_environment_tests.cpp")
  target_link_libraries(openxmb_process_environment_tests PRIVATE OpenXMB::Integrations)
  set_target_properties(openxmb_process_environment_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
  add_test(NAME openxmb_process_environment_tests COMMAND openxmb_process_environment_tests)
  add_executable(openxmb_overlay_tests "${_openxmb_integrations_root}/tests/integrations/xmb_overlay_tests.cpp")
  target_link_libraries(openxmb_overlay_tests PRIVATE OpenXMB::Integrations)
  set_target_properties(openxmb_overlay_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
  add_test(NAME openxmb_overlay_tests COMMAND openxmb_overlay_tests)
  add_executable(openxmb_session_hotkey_tests "${_openxmb_integrations_root}/tests/integrations/session_hotkey_tests.cpp")
  target_link_libraries(openxmb_session_hotkey_tests PRIVATE OpenXMB::Integrations)
  set_target_properties(openxmb_session_hotkey_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
  if(WIN32 OR APPLE)
    add_test(NAME openxmb_session_hotkey_tests COMMAND openxmb_session_hotkey_tests)
  endif()
  if(WIN32)
    include(CheckCXXSourceCompiles)
    check_cxx_source_compiles("#include <windows.h>\n#include <GameInput.h>\n#if defined(GAMEINPUT_API_VERSION) && GAMEINPUT_API_VERSION != 0\n#error Unsupported GameInput ABI\n#endif\nint main() { return 0; }" OPENXMB_HAS_GAMEINPUT_V0)
    if(OPENXMB_HAS_GAMEINPUT_V0)
      add_executable(openxmb_guide_input_tests "${_openxmb_integrations_root}/tests/integrations/guide_input_tests.cpp")
      target_include_directories(openxmb_guide_input_tests PRIVATE "${_openxmb_integrations_root}/include")
      target_compile_features(openxmb_guide_input_tests PRIVATE cxx_std_23)
      set_target_properties(openxmb_guide_input_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
      add_test(NAME openxmb_guide_input_tests COMMAND openxmb_guide_input_tests)
    endif()
    # Opt-in installed-runtime lifecycle check; never generates controller input.
    add_executable(openxmb_guide_input_runtime_tests EXCLUDE_FROM_ALL "${_openxmb_integrations_root}/tests/integrations/guide_input_runtime_tests.cpp")
    target_link_libraries(openxmb_guide_input_runtime_tests PRIVATE OpenXMB::Integrations)
    set_target_properties(openxmb_guide_input_runtime_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
    add_executable(openxmb_session_window_child EXCLUDE_FROM_ALL "${_openxmb_integrations_root}/tests/integrations/session_window_child.cpp")
    add_executable(openxmb_session_window_tests EXCLUDE_FROM_ALL "${_openxmb_integrations_root}/tests/integrations/session_window_tests.cpp")
    target_link_libraries(openxmb_session_window_child PRIVATE user32 gdi32)
    target_link_libraries(openxmb_session_window_tests PRIVATE OpenXMB::Integrations OpenXMB::DesktopCore)
    set_target_properties(openxmb_session_window_child openxmb_session_window_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
  endif()
  add_executable(openxmb_integrations_tests "${_openxmb_integrations_root}/tests/integrations/integration_tests.cpp")
  target_link_libraries(openxmb_integrations_tests PRIVATE OpenXMB::Integrations)
  set_target_properties(openxmb_integrations_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
  add_test(NAME openxmb_integrations_tests COMMAND openxmb_integrations_tests "$<TARGET_FILE:openxmb-integrations>")
  add_library(openxmb_test_retro_core SHARED "${_openxmb_integrations_root}/tests/integrations/test_core.cpp")
  target_include_directories(openxmb_test_retro_core PRIVATE "${_openxmb_integrations_root}/include")
  target_compile_features(openxmb_test_retro_core PRIVATE cxx_std_23)
  set_target_properties(openxmb_test_retro_core PROPERTIES CXX_SCAN_FOR_MODULES OFF PREFIX "")
  add_test(NAME openxmb_retro_host_smoke
    COMMAND "${CMAKE_COMMAND}" -DHOST=$<TARGET_FILE:openxmb-retro>
      -DCORE=$<TARGET_FILE:openxmb_test_retro_core>
      -DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/retro-smoke
      -P "${_openxmb_integrations_root}/tests/integrations/retro_smoke.cmake")
endif()
if(OPENXMB_BUILD_NATIVE_TESTS AND UNIX AND NOT APPLE)
  find_program(OPENXMB_XVFB_RUN xvfb-run)
  if(OPENXMB_XVFB_RUN)
    find_program(OPENXMB_XCOMPMGR xcompmgr)
    find_program(OPENXMB_BASH bash)
    if(OPENXMB_XCOMPMGR AND OPENXMB_BASH)
      add_executable(openxmb_x11_session_tests "${_openxmb_integrations_root}/tests/integrations/x11_session_tests.cpp")
      target_include_directories(openxmb_x11_session_tests PRIVATE ${X11_INCLUDE_DIR})
      target_link_libraries(openxmb_x11_session_tests PRIVATE OpenXMB::Integrations)
      set_target_properties(openxmb_x11_session_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
      add_test(NAME openxmb_x11_session_tests COMMAND "${CMAKE_COMMAND}" -E env
        "OPENXMB_X11_TEST_BINARY=$<TARGET_FILE:openxmb_x11_session_tests>" "OPENXMB_X11_COMPOSITOR=${OPENXMB_XCOMPMGR}"
        "${OPENXMB_BASH}" "${_openxmb_integrations_root}/tests/integrations/run_x11_session_tests.sh")
      set_tests_properties(openxmb_x11_session_tests PROPERTIES TIMEOUT 30)
    endif()
    add_test(NAME openxmb_session_hotkey_tests COMMAND "${OPENXMB_XVFB_RUN}" -a
      "${CMAKE_COMMAND}" -E env --unset=WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 OPENXMB_HOTKEY_TEST_ISOLATED=1
      "$<TARGET_FILE:openxmb_session_hotkey_tests>")
    set_tests_properties(openxmb_session_hotkey_tests PROPERTIES TIMEOUT 30)
    add_executable(openxmb_browser_input_tests "${_openxmb_integrations_root}/tests/integrations/browser_input_tests.cpp")
    target_include_directories(openxmb_browser_input_tests PRIVATE ${X11_INCLUDE_DIR})
    target_link_libraries(openxmb_browser_input_tests PRIVATE OpenXMB::Integrations)
    set_target_properties(openxmb_browser_input_tests PROPERTIES CXX_SCAN_FOR_MODULES OFF)
    add_test(NAME openxmb_browser_input_tests COMMAND "${OPENXMB_XVFB_RUN}" -a -s "-screen 0 800x600x24" "$<TARGET_FILE:openxmb_browser_input_tests>")
  endif()
endif()

# A native child web surface keeps page rendering out of the Vulkan frame loop.
# WebKit is optional; platforms without it retain the explicit system browser.
if(UNIX AND NOT APPLE)
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_check_modules(OPENXMB_WEBKIT QUIET IMPORTED_TARGET webkit2gtk-4.1 gtk+-3.0)
    if(OPENXMB_WEBKIT_FOUND)
      add_executable(openxmb-web src/integrations/web_view.cpp)
      target_link_libraries(openxmb-web PRIVATE PkgConfig::OPENXMB_WEBKIT nlohmann_json::nlohmann_json ${X11_LIBRARIES})
      target_compile_features(openxmb-web PRIVATE cxx_std_23)
      set_target_properties(openxmb-web PROPERTIES CXX_SCAN_FOR_MODULES OFF)
      install(TARGETS openxmb-web RUNTIME DESTINATION bin)
    endif()
  endif()
endif()
