# Initial setup prompts, navigation and save errors.

msgid "Initial Setup"
msgstr "प्रारंभिक सेटअप"

msgid "Select a language."
msgstr "भाषा चुनें।"

msgid "Select a time zone."
msgstr "समय क्षेत्र चुनें।"

msgid "Set the time and date."
msgstr "दिनांक और समय सेट करें।"

msgid "Enter your user name."
msgstr "अपना उपयोगकर्ता नाम दर्ज करें।"

msgid "Finish initial setup."
msgstr "प्रारंभिक सेटअप पूरा करें।"

msgid "Press Enter to finish initial setup."
msgstr "प्रारंभिक सेटअप पूरा करने के लिए Enter दबाएँ।"

msgid "Automatically adjust for daylight saving time"
msgstr "ग्रीष्मकालीन समय के लिए स्वतः समायोजित करें"

msgid "Use the system clock automatically"
msgstr "सिस्टम घड़ी का स्वतः उपयोग करें"

msgid "Use up and down to select. Press right to continue."
msgstr "चुनने के लिए ऊपर और नीचे दबाएँ। आगे बढ़ने के लिए दायाँ दबाएँ।"

msgid "Select a time zone or adjust daylight saving. Press right to continue."
msgstr "समय क्षेत्र चुनें या ग्रीष्मकालीन समय समायोजित करें। आगे बढ़ने के लिए दायाँ दबाएँ।"

msgid "Use up and down to adjust values; left and right select fields."
msgstr "मान बदलने के लिए ऊपर और नीचे दबाएँ; फ़ील्ड चुनने के लिए बायाँ और दायाँ दबाएँ।"

msgid "Edit the date and time or use the system clock. Press right to continue."
msgstr "दिनांक और समय संपादित करें या सिस्टम घड़ी का उपयोग करें। आगे बढ़ने के लिए दायाँ दबाएँ।"

msgid "Edit the user name, or press right to continue."
msgstr "उपयोगकर्ता नाम संपादित करें या आगे बढ़ने के लिए दायाँ दबाएँ।"

msgid "Finish initial setup?"
msgstr "प्रारंभिक सेटअप पूरा करें?"

msgid "Your choices will be saved for OpenXMB."
msgstr "आपके चयन OpenXMB के लिए सहेजे जाएँगे।"

msgid "Region"
msgstr "क्षेत्र"

msgid "Daylight saving"
msgstr "ग्रीष्मकालीन समय"

msgid "Toggle"
msgstr "चालू/बंद करें"

msgid "This time zone does not observe daylight saving time."
msgstr "इस समय क्षेत्र में ग्रीष्मकालीन समय लागू नहीं होता।"

msgid "Daylight saving rules are unavailable."
msgstr "ग्रीष्मकालीन समय के नियम उपलब्ध नहीं हैं।"

msgid "No time zone is available."
msgstr "कोई समय क्षेत्र उपलब्ध नहीं है।"

msgid "Could not save settings. Please try again."
msgstr "सेटिंग्स सहेजी नहीं जा सकीं। कृपया फिर से प्रयास करें।"

msgid "Could not save OpenXMB settings. Check that the profile folder is writable, then try again."
msgstr "OpenXMB की सेटिंग्स सहेजी नहीं जा सकीं। जाँचें कि प्रोफ़ाइल फ़ोल्डर में लिखने की अनुमति है, फिर दोबारा प्रयास करें।"

msgid "This local time is skipped or repeated by daylight saving. Choose a different time or turn off automatic daylight saving."
msgstr "ग्रीष्मकालीन समय के कारण यह स्थानीय समय छूट जाता है या दोहराया जाता है। कोई दूसरा समय चुनें या ग्रीष्मकालीन समय का स्वचालित समायोजन बंद करें।"

#. TRANSLATORS: Preserve every {...} token exactly; these tokens render input binding glyphs for the active device. Reorder them as needed.
msgid "Use {up} and {down} to select. Press {right} to continue."
msgstr "चुनने के लिए {up} और {down} का उपयोग करें। आगे बढ़ने के लिए {right} दबाएँ।"

#. TRANSLATORS: Preserve every {...} token exactly; these tokens render input binding glyphs for the active device. Reorder them as needed.
msgid "Use {up} and {down} to select. Press {extra} to adjust daylight saving time. Press {right} to continue."
msgstr "चुनने के लिए {up} और {down} का उपयोग करें। डेलाइट सेविंग टाइम समायोजित करने के लिए {extra} दबाएँ। आगे बढ़ने के लिए {right} दबाएँ।"

#. TRANSLATORS: Preserve every {...} token exactly; these tokens render input binding glyphs for the active device. Reorder them as needed.
msgid "Press {ok} to adjust daylight saving time. Press {extra} to return to the time zone list."
msgstr "डेलाइट सेविंग टाइम समायोजित करने के लिए {ok} दबाएँ। समय क्षेत्र की सूची पर लौटने के लिए {extra} दबाएँ।"

#. TRANSLATORS: Preserve every {...} token exactly; these tokens render input binding glyphs for the active device. Reorder them as needed.
msgid "Use {up} and {down} to adjust the setting value and use {left} and {right} to select setting items. Press {ok} to accept your selections."
msgstr "सेटिंग का मान बदलने के लिए {up} और {down} का उपयोग करें और सेटिंग के विकल्प चुनने के लिए {left} और {right} का उपयोग करें। अपने चयन की पुष्टि करने के लिए {ok} दबाएँ।"

#. TRANSLATORS: Preserve every {...} token exactly; these tokens render input binding glyphs for the active device. Reorder them as needed.
msgid "Press {ok} to set the date and time. Press {extra} to set automatically. Press {right} to continue."
msgstr "तारीख और समय सेट करने के लिए {ok} दबाएँ। अपने आप सेट करने के लिए {extra} दबाएँ। आगे बढ़ने के लिए {right} दबाएँ।"

#. TRANSLATORS: Preserve every {...} token exactly; these tokens render input binding glyphs for the active device. Reorder them as needed.
msgid "Press {ok} to enter a user name. Press {right} to continue."
msgstr "उपयोगकर्ता नाम दर्ज करने के लिए {ok} दबाएँ। आगे बढ़ने के लिए {right} दबाएँ।"


msgid "Credits"
msgstr "श्रेय"
