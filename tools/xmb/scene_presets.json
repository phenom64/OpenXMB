{
  "schema": 1,
  "description": "Deterministic headless capture presets for xmb-web visual parity scenes.",
  "defaults": {
    "width": 1920,
    "height": 1080,
    "frames": 4,
    "fixed_unix_seconds": 1781524800,
    "fixed_wave_seconds": 4.0,
    "background_type": "original",
    "theme_colour_mode": "original",
    "icon_glass_refraction": true,
    "sample_count": 1,
    "max_fps": 30
  },
  "scenes": {
    "root": {
      "description": "Users root after boot complete, Original theme, June afternoon",
      "pattern": "root-{:05d}.png",
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "users"
      }
    },
    "settings": {
      "description": "Settings category, System Settings focused (catalog index 4 in the PS3 root order)",
      "pattern": "settings-{:05d}.png",
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "settings",
        "OPENXMB_INITIAL_SETTINGS_MENU": "category.settings",
        "OPENXMB_INITIAL_SETTINGS_SELECTION": "4"
      }
    },
    "theme": {
      "description": "Theme Settings submenu focused",
      "pattern": "theme-{:05d}.png",
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "settings",
        "OPENXMB_INITIAL_SETTINGS_MENU": "category.settings.theme.settings"
      }
    },
    "theme-panel": {
      "description": "Theme Settings with Theme dialog panel open (Original selected)",
      "pattern": "theme-panel-{:05d}.png",
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "settings",
        "OPENXMB_INITIAL_SETTINGS_MENU": "category.settings.theme.settings",
        "OPENXMB_INITIAL_SETTINGS_SELECTION": "0",
        "OPENXMB_OPEN_INITIAL_SETTINGS_CHOICE": "1"
      }
    },
    "playlist-message": {
      "description": "Music root, Create Playlist activated: name message settles (flow capture)",
      "pattern": "playlist-message-{:05d}.png",
      "frames": 150,
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "music",
        "OPENXMB_HARNESS_ACTIONS": "2.5:down;3.5:ok"
      }
    },
    "playlist-keyboard": {
      "description": "Playlist name message, then the name field opens the on-screen keyboard (flow capture)",
      "pattern": "playlist-keyboard-{:05d}.png",
      "frames": 210,
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "music",
        "OPENXMB_HARNESS_ACTIONS": "2.5:down;3.5:ok;5.0:ok"
      }
    },
    "playlist-keyboard-accept": {
      "description": "Playlist keyboard accepted with START: returns to the name message with the field kept (flow capture)",
      "pattern": "playlist-keyboard-accept-{:05d}.png",
      "frames": 240,
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "music",
        "OPENXMB_HARNESS_ACTIONS": "2.5:down;3.5:ok;5.0:ok;6.6:start"
      }
    },
    "playlist-cancel": {
      "description": "Playlist keyboard cancelled, then the message backed out to the submenu (flow capture)",
      "pattern": "playlist-cancel-{:05d}.png",
      "frames": 270,
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "music",
        "OPENXMB_HARNESS_ACTIONS": "2.5:down;3.5:ok;5.0:ok;6.6:cancel;7.6:cancel"
      }
    },
    "users-options": {
      "description": "Users > Operating System Users > *User with the Triangle options panel open (flow capture)",
      "pattern": "users-options-{:05d}.png",
      "frames": 210,
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "users",
        "OPENXMB_HARNESS_ACTIONS": "2.0:down;2.4:down;2.8:down;3.2:ok;4.2:down;4.6:down;5.4:options"
      }
    },
    "users-information": {
      "description": "Users > *User > Triangle > Information screen with avatar focus (flow capture)",
      "pattern": "users-information-{:05d}.png",
      "frames": 240,
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "users",
        "OPENXMB_HARNESS_ACTIONS": "2.0:down;2.4:down;2.8:down;3.2:ok;4.2:down;4.6:down;5.4:options;6.4:ok"
      }
    },
    "users-name-keyboard": {
      "description": "Information screen, user name field, keyboard, then right-stick repositioning (flow capture)",
      "pattern": "users-name-keyboard-{:05d}.png",
      "frames": 330,
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "users",
        "OPENXMB_HARNESS_ACTIONS": "2.0:down;2.4:down;2.8:down;3.2:ok;4.2:down;4.6:down;5.4:options;6.4:ok;7.4:down;8.0:ok;9.4:rs=0,-1;9.65:rs=0,0"
      }
    },
    "settings-keyboard": {
      "description": "System Settings > System Name text entry over the crossbar (Internet Search context analogue)",
      "pattern": "settings-keyboard-{:05d}.png",
      "frames": 150,
      "env": {
        "OPENXMB_INITIAL_SETTINGS_MENU": "category.settings.desktop.System",
        "OPENXMB_INITIAL_SETTINGS_SELECTION": "0",
        "OPENXMB_OPEN_INITIAL_SETTINGS_CHOICE": "1"
      }
    },
    "network": {
      "description": "Network category: Internet Browser with the WWW icon",
      "pattern": "network-{:05d}.png",
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "network"
      }
    },
    "tv-services": {
      "description": "TV / Video Services category (duplicate browser removed)",
      "pattern": "tv-services-{:05d}.png",
      "env": {
        "OPENXMB_INITIAL_CATEGORY": "tv"
      }
    }
  }
}
